# Run scripts/setup.sh to generate secrets. Do not use example values.
ENCRYPTION_KEY=
INTERNAL_KEY=
APP_ORIGIN=http://localhost:5173
HELIX_URL=http://127.0.0.1:6996
EXECUTOR_URL=http://127.0.0.1:3002
OLLAMA_URL=http://127.0.0.1:11434
DATA_DIR=.data
# Compose: the browser origin. There is no sign-in, so keep it on this computer.
PUBLIC_ORIGIN=http://localhost:3001
PUBLIC_PORT=3001
# MODEL_ENDPOINT=http://host.docker.internal:11434
# Executor limits; unset means the default. The time limits are whole or
# decimal seconds from 1 to 86400. See "Deployment limits" in docs/OPERATIONS.md.
# DUCKDB_SPILL_LIMIT=20GB
# EXECUTOR_RESULT_LIMIT=2GB
# EXECUTOR_QUERY_TIMEOUT=120
# EXECUTOR_JOB_TIMEOUT=900
# Compose memory budgets and model keep-alive (docs/OPERATIONS.md#memory).
# OLLAMA_MEMORY_LIMIT=6g
# HELIX_MEMORY_RESERVATION=2g
# MODEL_KEEP_ALIVE=30s
# Optional provider sign-in. Register each integration and its workspace callback URL.
# See docs/HOSTING.md. Leave blank to use provider API keys or direct connections.
NEON_CLIENT_ID=
NEON_CLIENT_SECRET=
SUPABASE_CLIENT_ID=
SUPABASE_CLIENT_SECRET=
PLANETSCALE_CLIENT_ID=
PLANETSCALE_CLIENT_SECRET=
# Mihrab: Azure AI Foundry (optional). The endpoint is the resource URL, e.g.
# https://NAME.openai.azure.com, https://NAME.services.ai.azure.com/models or
# https://NAME.openai.azure.com/openai/v1 (then AZURE_FOUNDRY_API_VERSION=v1).
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_API_VERSION=2024-10-21
# Comma-separated deployment names, e.g. claude-sonnet-5,gpt-4o,DeepSeek-R1. Names
# containing "claude" use Anthropic's Messages API (endpoint
# https://NAME.services.ai.azure.com/anthropic/v1/messages works); others use
# chat completions on the same resource.
AZURE_FOUNDRY_DEPLOYMENTS=
# MIHRAB_CLAUDE_EFFORT=medium        # low | medium | high | xhigh | max (model default if unset)
# Mihrab: Azure embeddings (text-embedding-3-large or similar).
AZURE_FOUNDRY_EMBEDDINGS_ENDPOINT=
AZURE_FOUNDRY_EMBEDDINGS_KEY=
AZURE_FOUNDRY_EMBEDDINGS_DEPLOYMENT=
# AZURE_FOUNDRY_EMBEDDINGS_DIMENSIONS=1024   # or "full"
# Which vectors answers search: ollama (default) or azure_foundry. Build them first:
# pnpm mihrab:seed --embed-provider azure_foundry
# MIHRAB_EMBED_PROVIDER=ollama
# Mihrab: model picked when the browser has no saved choice (azure_foundry or ollama).
# MIHRAB_DEFAULT_PROVIDER=ollama
# MIHRAB_DEFAULT_MODEL=qwen3:4b
# MIHRAB_EMBED_MODEL=nomic-embed-text-v2-moe
# MIHRAB_CORPUS_DIR=data/ring1_golden_corpus
